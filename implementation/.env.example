# Copy this file to .env and fill it in.
# Never commit the real .env because it holds your key.

# Free key from https://console.groq.com.
# It covers both the AI and speech-to-text.
AI_API_KEY=

# These three have sensible defaults.
# Change them to use another service.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
# SPEECH_MODEL=whisper-large-v3-turbo

# To keep the writing on your own computer, install Ollama and use these.
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3:8b
# SPEECH_BASE_URL=https://api.groq.com/openai/v1
# Ollama can't do speech-to-text, so SPEECH_BASE_URL keeps voice pointed at Groq.
# Skip that line and type your answers if nothing should leave your computer.

# Microphone settings, which you can leave alone unless recording misbehaves.
# MIC_DEVICE=1
# MIC_DEVICE is the number shown by: python voice_to_post.py --check
# MIC_LEVEL=0.012
# Raise MIC_LEVEL in a noisy room, and lower it if you're not being heard.

# API server only, the web pages allowed to call it, separated by commas.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
